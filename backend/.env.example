# Copy to backend/.env and fill in ONE provider.

# Free option: Google AI Studio key (https://aistudio.google.com/apikey)
PARLEY_PROVIDER=gemini
GEMINI_API_KEY=

# Or Claude (paid): https://console.anthropic.com/settings/keys
# PARLEY_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Optional overrides (see src/parley/config.py)
# PARLEY_AGENT_MODEL=
# PARLEY_AGENT_MODEL=gemini-3.5-flash   # stronger, but slow on the free tier
# PARLEY_GEMINI_REQUESTS_PER_MINUTE=30
